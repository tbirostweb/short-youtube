# .gitkeep restent suivis).
data/assets/broll/*.mp4
data/assets/music/*.mp3

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/

# OS
.DS_Store
.claude
/claude
./claude

.dockerignore
.env.example
.idea