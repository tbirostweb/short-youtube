# Secrets & tokens (TOUT credentials sauf le .gitkeep)
.env
credentials/*
!credentials/.gitkeep

# Sorties & cache
output/
data/shorts.db
data/shorts.db-*
data/cache/

# Médias récupérés à la volée (Pexels/Pixabay pour la vidéo, incompetech pour
