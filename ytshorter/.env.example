############################################
# ytshorter — configuration
# Copier ce fichier en .env puis remplir.
# Toutes ces variables restent CÔTÉ SERVEUR.
# Aucune n'est injectée dans le bundle navigateur.
############################################

# ---------- Base de données MySQL ----------
# Hôte MySQL. En Docker Compose, c'est le nom du service : "mysql".
MYSQL_HOST=mysql
# Port MySQL.
MYSQL_PORT=3306
# Nom de la base créée au premier démarrage du conteneur mysql.
MYSQL_DATABASE=ytshorter
# Utilisateur applicatif (créé automatiquement par l'image mysql).
MYSQL_USER=ytshorter
# Mot de passe de l'utilisateur applicatif. À CHANGER.
MYSQL_PASSWORD=change_me_app_password
# Mot de passe root, utilisé uniquement par le conteneur mysql. À CHANGER.
MYSQL_ROOT_PASSWORD=change_me_root_password

# ---------- Redis (file BullMQ + bus SSE) ----------
# URL de connexion Redis. En Compose : redis://redis:6379
REDIS_URL=redis://redis:6379

# ---------- Fournisseurs LLM (100% gratuit) ----------
# Chaîne de bascule, dans l'ordre d'essai, séparée par des virgules.
# Valeurs possibles : gemini, groq, ollama
# Le premier de la liste est le fournisseur par défaut.
LLM_PROVIDER_CHAIN=gemini,groq,ollama
# Fournisseur préféré. S'il est renseigné, il est placé en tête de la chaîne.
LLM_PROVIDER=gemini
# Clé API Google AI Studio (offre gratuite à quota). https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modèle Gemini utilisé (gratuit à quota).
# ATTENTION : les fournisseurs RETIRENT régulièrement leurs modèles. Si les
# jobs échouent avec MODEL_UNAVAILABLE, c'est qu'il faut mettre cette valeur à
# jour. Le message d'erreur du worker indique le modèle de remplacement.
GEMINI_MODEL=gemini-3.6-flash
# Clé API Groq (offre gratuite à quota). https://console.groq.com/keys
GROQ_API_KEY=
# Modèle LLM Groq. Les modèles Llama sont réservés au palier Enterprise :
# sur une clé gratuite, utiliser openai/gpt-oss-120b (ou -20b, plus rapide).
# Pour lister ceux auxquels votre clé a droit :
#   curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
GROQ_MODEL=openai/gpt-oss-120b
# Effort de raisonnement des modèles gpt-oss : low | medium | high.
# Ces modèles dépensent des tokens à « réfléchir » AVANT de répondre ; en
# 'medium' (défaut du modèle) la réponse JSON se retrouve tronquée et le job
# échoue en PROVIDER_ERROR. 'low' divise cette dépense par ~20 sans perte ici.
# Vider la variable pour ne pas envoyer le paramètre du tout.
GROQ_REASONING_EFFORT=low
# URL du serveur Ollama auto-hébergé (repli sans clé et sans quota).
# En Compose avec le profil "ollama" : http://ollama:11434
OLLAMA_URL=http://ollama:11434
# Modèle Ollama (petit modèle, CPU only).
OLLAMA_MODEL=qwen2.5:3b

# ---------- Transcription ----------
# whispercpp = auto-hébergé, sans clé, lent sur CPU (défaut)
# groq       = API Groq Whisper, gratuite à quota, beaucoup plus rapide
TRANSCRIBER=whispercpp
# Chemin du modèle ggml dans le conteneur worker (volume "models").
# Téléchargé automatiquement au démarrage du worker s'il est absent.
# Modèles conseillés : ggml-base.bin (rapide) ou ggml-small.bin (meilleur).
WHISPER_MODEL_PATH=/models/ggml-base.bin
# Nombre de threads whisper.cpp (adapter au nombre de vCPU du VPS).
WHISPER_THREADS=4
# Langue forcée pour la transcription ("auto" = détection automatique).
WHISPER_LANGUAGE=auto
# Modèle Groq de transcription (utilisé si TRANSCRIBER=groq).
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo

# ---------- Téléchargement YouTube (yt-dlp) ----------
# Depuis un VPS, YouTube bloque souvent les IP de datacenter avec un
# « Sign in to confirm you're not a bot ». Deux réglages pour y faire face :
#
# 1 = met yt-dlp à jour au démarrage du worker (best-effort, recommandé).
YTDLP_AUTO_UPDATE=1
# Cookies d'une session YouTube connectée, ENCODÉS EN BASE64 (une seule ligne).
# C'est ce qui débloque le téléchargement depuis le serveur. Voir le README,
# section « Télécharger depuis YouTube sur un VPS ». Laisser vide pour ne pas
# les utiliser (l'upload de fichier .mp4 reste alors la voie fiable).
# Génération : base64 -w0 cookies.txt   (Linux)  /  base64 -i cookies.txt (macOS)
YTDLP_COOKIES_B64=

# ---------- Limites média ----------
# Durée maximale acceptée pour une vidéo source, en minutes.
MAX_VIDEO_MINUTES=90
# Répertoire du volume média partagé entre api et worker.
MEDIA_DIR=/media
# Taille maximale du fichier source téléchargé (garde-fou disque), en Mo.
MAX_SOURCE_MB=2048
# Taille maximale d'un fichier vidéo envoyé par l'utilisateur, en Mo.
# Doit rester inférieure ou égale au client_max_body_size de web/nginx.conf.
MAX_UPLOAD_MB=500

# ---------- Conservation et nettoyage ----------
# 1 = conserve les découpes après succès, ce qui permet de re-styliser un clip
#     (autre style de sous-titres, autre cadrage) sans refaire la génération
#     ni consommer de quota. 0 = nettoyage strict, re-stylisation impossible.
KEEP_CUTS_FOR_RESTYLE=1
# Âge au-delà duquel un job terminé et ses fichiers sont supprimés, en jours.
# 0 désactive la suppression automatique (le disque grossira sans limite).
RETENTION_DAYS=7
# Âge au-delà duquel un fichier envoyé mais jamais utilisé est supprimé, en heures.
UPLOAD_TTL_HOURS=24
# Périodicité du passage de nettoyage, en minutes.
RETENTION_INTERVAL_MINUTES=60

# ---------- Cadrage automatique ----------
# 1 = le cadre suit le sujet (visage, sinon point d'intérêt) — défaut
# 0 = recadrage centré ajustable uniquement
# Le suivi ajoute une passe d'analyse Python par clip. En cas d'échec ou de
# suivi peu fiable, le recadrage centré reprend la main automatiquement.
TRACKING_CROP=1

# ---------- Marge de découpe ----------
# Secondes conservées de part et d'autre de chaque extrait. C'est cette marge
# qui permet d'ajuster les bornes d'un clip après coup — rattraper un extrait
# qui démarre une seconde trop tard — sans conserver la vidéo source ni
# relancer la génération. Compter environ 10 % de disque en plus par seconde.
# 0 la désactive : les bornes ne seront alors plus ajustables.
CUT_PAD_SECONDS=2.5

# ---------- Qualité de rendu ----------
# 1 = aligne le volume de chaque clip sur -14 LUFS (cible des plateformes),
#     en deux passes : mesure puis gain constant. Un passage silencieux n'est
#     pas normalisé. 0 = aucune correction de volume.
AUDIO_NORMALIZE=1
# Durée du fondu de fermeture, en secondes. 0 le désactive.
# Il n'y a volontairement pas de fondu d'ouverture : sur un format court,
# les premiers dixièmes de seconde sont l'accroche.
RENDER_FADE_OUT=0.25
# Préréglage et qualité x264 du rendu final.
# Plus lent = fichier plus petit à qualité égale (ultrafast … veryslow).
X264_PRESET=veryfast
# 18 = très haute qualité, 23 = qualité correcte. 21 par défaut.
X264_CRF=21

# ---------- Secrets ----------
# Clé HMAC des liens de téléchargement signés. À GÉNÉRER :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SIGNING_SECRET=change_me_signing_secret
# Durée de validité d'un lien de téléchargement signé, en secondes.
SIGNED_URL_TTL=900
# Clé de signature des cookies de session. À GÉNÉRER de la même façon.
SESSION_SECRET=change_me_session_secret

# ---------- Authentification ----------
# 0 = mode mono-utilisateur sans compte (les contrôles d'appartenance
#     restent actifs via un cookie de session anonyme signé)
# 1 = comptes email/mot de passe activés
AUTH_ENABLED=0

# ---------- Limitation de débit ----------
# Fenêtre de la limitation, en millisecondes.
RATE_LIMIT_WINDOW=900000
# Nombre maximum de requêtes API par IP et par fenêtre.
RATE_LIMIT_MAX=200
# Nombre maximum de créations de job par IP/utilisateur et par fenêtre.
RATE_LIMIT_JOBS_MAX=10
# Nombre maximum de tentatives d'authentification par IP et par fenêtre.
RATE_LIMIT_AUTH_MAX=10
# Nombre maximum de re-stylisations de clip par IP/utilisateur et par fenêtre.
RATE_LIMIT_RESTYLE_MAX=30

# ---------- Divers ----------
# URL publique de l'application (utilisée pour les liens absolus et les cookies).
PUBLIC_BASE_URL=http://localhost:8080
# production | development
NODE_ENV=production
# Port d'écoute interne du service api.
API_PORT=3000
# Port publié par le service web (nginx) sur l'hôte.
WEB_PORT=8080
# Niveau de log de l'api et du worker : fatal|error|warn|info|debug|trace
LOG_LEVEL=info
# Nombre de générations affichées par page dans l'historique.
HISTORY_PAGE_SIZE=20
